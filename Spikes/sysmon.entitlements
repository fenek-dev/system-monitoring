<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Spike only: sysmond rejects clients lacking this entitlement. Tests whether ad-hoc signing can claim it. -->
<plist version="1.0">
<dict>
	<key>com.apple.sysmond.client</key>
	<true/>
</dict>
</plist>
